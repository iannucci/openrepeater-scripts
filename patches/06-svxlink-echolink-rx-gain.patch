     // Create audio pipe chain for audio received from the remove EchoLink
     // stations: (QsoImpl -> ) Selector -> Fifo -> <to core>
   selector = new AudioSelector;
-  AudioSource::setHandler(selector);
+
+  // ORP patch: insert a configurable gain stage in the RX path (audio
+  // from remote EchoLink stations into the local logic core, broadcast
+  // out the local TX). EchoLink protocol delivers audio at a fixed
+  // level typically 6-10 dB below local sound files and RF traffic at
+  // the repeater output, so remote EchoLink users sound noticeably
+  // quieter on the air than local users. The LOCAL_AUDIO_GAIN setting
+  // in svxlink.conf [ModuleEchoLink] (in dB) controls this; default
+  // 0 dB matches upstream behavior.
+  float local_audio_gain_db = 0.0f;
+  cfg().getValue(cfgName(), "LOCAL_AUDIO_GAIN", local_audio_gain_db);
+  AudioAmp *rx_amp = new AudioAmp;
+  rx_amp->setGain(local_audio_gain_db);
+  selector->registerSink(rx_amp);
+  AudioSource::setHandler(rx_amp);
   
