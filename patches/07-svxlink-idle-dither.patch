+
+    // ORP patch: idle dither. A second SineGenerator that writes
+    // directly to the codec (same mechanism as CTCSS sine_gen above),
+    // bypassing the audio chain and therefore PttCtrl's audio-activity
+    // detection. Goal: keep the DAC seeing a small non-zero input
+    // during otherwise-silent moments inside a TX cycle, so any active
+    // feedback loop downstream of the codec (DAC sigma-delta modulator,
+    // radio's modulator PLL, radio's audio AGC) doesn't enter a
+    // limit-cycle oscillation that's audible as a buzz.
+    //
+    // Configured via IDLE_DITHER_FQ (Hz) and IDLE_DITHER_LEVEL (dBFS)
+    // in svxlink.conf [<TX>] section. Both must be set for the dither
+    // to activate. SineGenerator::enable() is a no-op when fq==0, so
+    // omitting either setting disables the feature.
+    idle_dither_gen = new SineGenerator(audio_dev, audio_channel);
+    if (cfg.getValue(name(), "IDLE_DITHER_FQ", value))
+    {
+      idle_dither_gen->setFq(atof(value.c_str()));
+    }
+    float idle_dither_level = 0.0f;
+    if (cfg.getValue(name(), "IDLE_DITHER_LEVEL", idle_dither_level))
+    {
+      idle_dither_gen->setLevel(idle_dither_level);
+    }
 
   float ctcss_level = 0.0f;
   if (cfg.getValue(name(), "CTCSS_LEVEL", ctcss_level))
