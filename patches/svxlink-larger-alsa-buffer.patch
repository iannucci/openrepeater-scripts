+      // a TX underrun (audible mid-transmission stutter, observed
+      // via svxlink-audio-monitor's tx_xrun_real_mid events).
+      AudioIO::setBlocksize(2048);   // 43 ms period
+      AudioIO::setBlockCount(8);     // 341 ms buffer (4x upstream)
     }
