+/****************************************************************************
+ *
+ * RX jitter buffer implementation
+ *
+ * The legacy EchoLink RX path wrote decoded audio samples directly to the
+ * downstream AudioSink as each UDP datagram was received. This left the
+ * application with no tolerance for out-of-order arrival, delay variance, or
+ * short gaps — any of which produces an audible artifact because GSM 6.10
+ * has no packet-loss concealment and the audio pipe has no elastic buffer.
+ *
+ * This implementation inserts a small FIFO playout buffer between the
+ * network decode step and the sink. Packets are indexed by their RTP
+ * sequence number (which the encoder was already writing but the decoder
+ * was throwing away). A periodic BLOCK_TIME timer drains the buffer in
+ * order, emitting silence for any slot whose packet has not arrived in
+ * time or has been dropped for being too old.
+ *
+ * Tuning notes (see ~/Documents/Claude/jitter/simulate_jitter_buffer.py for
+ * the empirical work). Against three 5-minute captures of a real Newsline
+ * stream at W6EI under clean, upload-loaded, and download-loaded conditions:
+ *   depth=3 (240ms) eliminates 89-91% of audible glitches in clean and
+ *   download conditions, at a latency cost that is imperceptible in
+ *   half-duplex amateur-radio operation.
+ *
+ ****************************************************************************/
+
+void Qso::jitterBufferReset(void)
+{
+  m_jitter_buf.clear();
+  m_playout_started = false;
+  m_playout_head = 0;
+  if (m_playout_timer != 0)
+  {
+    delete m_playout_timer;
+    m_playout_timer = 0;
+  }
+  m_pending_samples.clear();
+  m_pending_samples_pos = 0;
+  m_silent_ticks = 0;
+} /* Qso::jitterBufferReset */
+
+
+void Qso::jitterBufferInsert(uint16_t seq, const float *samples, int count)
+{
+  // With target depth 0 the jitter buffer is effectively disabled and we
+  // fall through to the legacy behaviour of writing samples directly to
+  // the sink on packet arrival.
+  if (JITTER_TARGET_DEPTH <= 0)
+  {
+    sinkWriteSamples(samples, count);
+    return;
+  }
+
+  // If playout has already started, reject any packet whose sequence
+  // number is older than the playout head (mod 2^16). Such a packet is
+  // too late to be useful — its slot has already been played (as real
+  // audio or as silence).
+  if (m_playout_started)
+  {
+    uint16_t diff = static_cast<uint16_t>(seq - m_playout_head);
+    if (diff > 32768)
+    {
+      return;  // too old; drop
+    }
+  }
+
+  // Insert / overwrite the frame in the buffer.
+  std::vector<float> &slot = m_jitter_buf[seq];
+  slot.assign(samples, samples + count);
+
+  // If the buffer has grown beyond the max allowed depth, evict the oldest
+  // entry by sequence number — i.e., the entry most in the past relative
+  // to the playout head (or the numerically smallest in the map if playout
+  // hasn't started yet).
+  while (static_cast<int>(m_jitter_buf.size()) > JITTER_MAX_DEPTH)
+  {
+    std::map<uint16_t, std::vector<float> >::iterator oldest = m_jitter_buf.begin();
+    if (m_playout_started)
+    {
+      // Find the entry with the smallest positive distance from the
+      // playout head, mod 2^16. That's the next one that would be played.
+      uint16_t best_diff = 0xffff;
+      for (std::map<uint16_t, std::vector<float> >::iterator it = m_jitter_buf.begin();
+           it != m_jitter_buf.end(); ++it)
+      {
+        uint16_t d = static_cast<uint16_t>(it->first - m_playout_head);
+        if (d < best_diff)
+        {
+          best_diff = d;
+          oldest = it;
+        }
+      }
+    }
+    m_jitter_buf.erase(oldest);
+  }
+
+  // If playout hasn't started yet and the buffer has reached target depth,
+  // start the playout timer and pick the initial head.
+  if (!m_playout_started &&
+      static_cast<int>(m_jitter_buf.size()) >= JITTER_TARGET_DEPTH)
+  {
+    // Start playing the smallest sequence number in the buffer — that's
+    // the oldest packet we have, and it's the natural starting point.
+    m_playout_head = m_jitter_buf.begin()->first;
+    m_playout_started = true;
+    if (m_playout_timer == 0)
+    {
+      m_playout_timer = new Timer(BLOCK_TIME, Timer::TYPE_PERIODIC);
+      m_playout_timer->expired.connect(
+          mem_fun(*this, &Qso::jitterPlayoutTick));
+    }
+  }
+} /* Qso::jitterBufferInsert */
+
+
+int Qso::tryDrainPendingSamples(void)
+{
+  if (m_pending_samples.empty())
+  {
+    return 0;
+  }
+  const int remaining = static_cast<int>(m_pending_samples.size()) -
+                        static_cast<int>(m_pending_samples_pos);
+  if (remaining <= 0)
+  {
+    m_pending_samples.clear();
+    m_pending_samples_pos = 0;
+    return 0;
+  }
+  const float *ptr = &m_pending_samples[m_pending_samples_pos];
+  int written = sinkWriteSamples(ptr, remaining);
+  if (written <= 0)
+  {
+    return 0;  // sink still not accepting
+  }
+  m_pending_samples_pos += written;
+  if (static_cast<int>(m_pending_samples_pos) >=
+      static_cast<int>(m_pending_samples.size()))
+  {
+    m_pending_samples.clear();
+    m_pending_samples_pos = 0;
+  }
+  return written;
+} /* Qso::tryDrainPendingSamples */
+
+
+void Qso::jitterPlayoutTick(Timer *timer)
+{
+  // Guard against firing after a soft reset (underrun pause). The timer
+  // keeps running but jitterBufferReset does not delete it from inside
+  // this callback to avoid use-after-free. The tick becomes a no-op
+  // until jitterBufferInsert re-accumulates JITTER_TARGET_DEPTH packets
+  // and sets m_playout_started back to true.
+  if (!m_playout_started)
+  {
+    return;
+  }
+  // If there is still backpressure from a previous tick, try that first.
+  // If the sink still can't accept it, skip this tick — the timer will
+  // fire again in BLOCK_TIME and we'll try again. (resumeOutput will
+  // also call tryDrainPendingSamples if the sink unblocks in between.)
+  if (!m_pending_samples.empty())
+  {
+    tryDrainPendingSamples();
+    if (!m_pending_samples.empty())
+    {
+      return;
+    }
+  }
+
+  // Try to play the packet at m_playout_head. If it's in the buffer,
+  // consume and write it. If not, write a block of silence to keep the
+  // downstream sink at a steady cadence.
+  std::map<uint16_t, std::vector<float> >::iterator it =
+      m_jitter_buf.find(m_playout_head);
+
+  const float *samples;
+  int count;
+  float silence[BUFFER_SIZE];
+
+  if (it != m_jitter_buf.end())
+  {
+    samples = it->second.data();
+    count = static_cast<int>(it->second.size());
+    m_silent_ticks = 0;
+  }
+  else
+  {
+    // Underrun. If we have been silent for long enough to conclude this is
+    // a sender-initiated pause rather than network jitter, reset playout
+    // state and stop emitting anything. The next arriving packet will
+    // restart playout fresh at its own sequence number via the normal
+    // JITTER_TARGET_DEPTH accumulation path in jitterBufferInsert.
+    // This is critical: without it, m_playout_head advances unbounded
+    // during the pause and every subsequent real packet is rejected as
+    // too-old by jitterBufferInsert, producing permanent dead air.
+    if (++m_silent_ticks >= JITTER_UNDERRUN_RESET_TICKS)
+    {
+      // Soft reset: clear the buffer and go back to the pre-playout
+      // state. The periodic timer keeps running but becomes a no-op via
+      // the !m_playout_started guard at the top of this function. The
+      // first packet arriving after this point will re-accumulate the
+      // buffer to JITTER_TARGET_DEPTH and jitterBufferInsert will flip
+      // m_playout_started back to true with m_playout_head anchored to
+      // whatever the fresh sender sequence is. Critically we do NOT
+      // delete m_playout_timer here because we are inside its own
+      // callback and freeing it would be a use-after-free.
+      m_jitter_buf.clear();
+      m_playout_started = false;
+      m_silent_ticks = 0;
+      m_playout_head = 0;
+      return;
+    }
+    for (int i = 0; i < BUFFER_SIZE; ++i) silence[i] = 0.0f;
+    samples = silence;
+    count = BUFFER_SIZE;
+  }
+
+  int written = sinkWriteSamples(samples, count);
+  if (written < count)
+  {
+    // Sink accepted only part of the block. Stash the rest so the next
+    // tick (or resumeOutput) can finish it.
+    m_pending_samples.assign(samples + written, samples + count);
+    m_pending_samples_pos = 0;
+  }
+
+  // Consume the buffered entry (if any) and advance the playout head
+  // regardless. Advancing even on miss is the correct behaviour during
+  // short underruns (network jitter) — the slot has been played as
+  // silence and the stream keeps marching. Long underruns are caught
+  // by the JITTER_UNDERRUN_RESET_TICKS check above.
+  if (it != m_jitter_buf.end())
+  {
+    m_jitter_buf.erase(it);
+  }
+  m_playout_head = static_cast<uint16_t>(m_playout_head + 1);
+} /* Qso::jitterPlayoutTick */
